menu "Risc-V Specific firmware drivers"
depends on RISCV

config RISCV_SSE
	bool
	depends on RISCV_SBI
	default y
	help
	  The Supervisor Software Events support allow the SBI to deliver
	  NMI-like notifications to the supervisor mode software. When enable,
	  this option provides support to register callbacks on specific SSE
	  events.

config RISCV_SSE_TEST
	bool "Enable SSE test at boot time"
	depends on RISCV_SSE
	default n
	help
	  Select if you want to enable SSE extension testing at boot time.
	  This will run a series of test which verifies SSE sanity.

endmenu
